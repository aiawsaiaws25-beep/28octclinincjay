<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Lakeside Medical Clinic in JLT, Dubai. Explore general physician, ENT, dental and cardiology care, opening hours and contact information." />
    <meta name="theme-color" content="#153f68" />
    <title><%= title %> - Lakeside Medical Clinic</title>
    <link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg" aria-label="Main navigation">
            <div class="container">
                <a class="navbar-brand clinic-brand" href="/" aria-label="Lakeside Medical Clinic home">
                    <span class="brand-mark" aria-hidden="true"><i class="bi bi-plus-lg"></i></span>
                    <span>Lakeside<span class="brand-subtitle">MEDICAL CLINIC</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-navigation" aria-controls="main-navigation" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="main-navigation">
                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        <li class="nav-item"><a class="nav-link" href="/#home">Home</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#specialties">Our specialties</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#about">About us</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#contact">Contact</a></li>
                        <% if (currentUser) { %>
                            <% if (currentUser.role === 'reception') { %>
                                <li class="nav-item"><a class="nav-link" href="/reception">Reception</a></li>
                            <% } %>
                            <li class="nav-item"><a class="nav-link" href="/MyAppointments">My Appointments</a></li>
                            <li class="nav-item">
                                <form method="post" action="/Account/Logout">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                                    <button type="submit" class="nav-link">Logout</button>
                                </form>
                            </li>
                        <% } else { %>
                            <li class="nav-item"><a class="nav-link" href="/Account/Register">Register</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Account/Login">Login</a></li>
                        <% } %>
                    </ul>
                    <a class="btn btn-primary nav-booking" href="/Booking">Book an appointment <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
                </div>
            </div>
        </nav>
    </header>
    <main id="main-content" tabindex="-1">
