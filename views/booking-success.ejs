<%- include('partials/header') %>
<% const booked = appointment && appointment.status === 'Booked'; %>
<section class="section-space">
    <div class="container booking-container">
        <div class="booking-panel">
            <% if (errorMessage) { %>
                <h1 class="page-title">Payment verification unavailable</h1>
                <div class="alert alert-warning" role="alert"><%= errorMessage %></div>
            <% } else if (booked) { %>
                <span class="confirmation-icon"><i class="bi bi-check-circle" aria-hidden="true"></i></span>
                <span class="eyebrow">STRIPE TEST PAYMENT VERIFIED</span>
                <h1 class="page-title">Booking confirmed</h1>
                <p>Your AED 100 refundable consultation deposit has been paid in Stripe test mode. No real money was charged.</p>
            <% } else { %>
                <h1 class="page-title">Payment not completed</h1>
                <div class="alert alert-warning" role="status">
                    <% if (appointment && appointment.status === 'Cancelled') { %>
                        <span>This appointment is cancelled and has not been rebooked. Contact the clinic about any deposit refund.</span>
                    <% } else { %>
                        <span>Your appointment remains Pending. A redirect alone does not confirm payment. Refresh this page after completing Stripe checkout, or contact the clinic if you need help.</span>
                    <% } %>
                </div>
            <% } %>
            <% if (appointment) { %>
                <dl class="appointment-details">
                    <dt>Reference</dt><dd>LM-<%= appointment.id %></dd>
                    <dt>Specialty</dt><dd><%= appointment.specialty %></dd>
                    <dt>Doctor</dt><dd><%= appointment.doctor %></dd>
                    <dt>Date &amp; time</dt><dd><%= displayDate %> at <%= displayTime %> (Dubai)</dd>
                    <dt>Patient</dt><dd><%= appointment.patientName %></dd>
                    <dt>Phone</dt><dd><%= appointment.patientPhone %></dd>
                    <dt>Email</dt><dd><%= appointment.patientEmail %></dd>
                    <dt>Status</dt><dd><%= appointment.status %></dd>
                </dl>
            <% } %>
            <p class="form-text">Refunds are handled by the clinic through Stripe; cancelling an appointment does not automatically issue a refund. Keep this private checkout link safe.</p>
            <div class="d-flex flex-wrap gap-3 mt-4">
                <a class="btn btn-primary" href="/MyAppointments">My Appointments</a>
                <a class="btn btn-outline-primary" href="/Booking">Back to booking</a>
            </div>
        </div>
    </div>
</section>
<%- include('partials/footer') %>
