# Copy this file to .env for local development. Never commit .env or share real keys.
# On Vercel, add the same names under Project Settings -> Environment Variables.

# Signs the login session cookie. Use a long random value (at least 32 characters).
SESSION_SECRET=

# Reception staff login (reception@lakeside.local). The password is stored bcrypt-hashed.
RECEPTION_PASSWORD=
# RECEPTION_EMAIL=reception@lakeside.local

# Ask Lakeside chat assistant (server-side only).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Stripe TEST secret key (sk_test_...) for the AED 100 deposit, and the public site URL.
STRIPE_SECRET_KEY=
BASE_URL=http://localhost:5221

# Persistent database for Vercel (Turso / libSQL). Leave empty locally to use data/lakeside.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
