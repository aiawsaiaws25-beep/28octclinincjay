@page
@model IndexModel
@{
    ViewData["Title"] = "Expert care, close to home";
}

<section class="hero section-anchor" id="home" aria-labelledby="hero-title">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6 hero-copy">
                <span class="eyebrow"><span class="status-dot"></span> YOUR NEIGHBOURHOOD CLINIC IN JLT, DUBAI</span>
                <h1 id="hero-title">Expert care,<br /><span>close to home.</span></h1>
                <p class="hero-description">Welcome to Lakeside Medical Clinic. Thoughtful, personalised care for you and your family, right here in your community.</p>
                <div class="d-flex flex-wrap gap-3 hero-actions">
                    <a class="btn btn-primary" asp-page="/Booking/Index">Book an appointment <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
                    <a class="btn btn-outline-primary" href="#specialties">Explore our specialties</a>
                </div>
                <div class="hero-note"><i class="bi bi-clock" aria-hidden="true"></i> Here for you Monday to Saturday, 9am - 9pm</div>
            </div>
            <div class="col-lg-6">
                <div class="hero-visual">
                    <div class="visual-label"><span class="small-cross" aria-hidden="true">+</span> A little closer. A little more care.</div>
                    <img class="clinic-illustration" src="~/images/clinic.svg" alt="Illustration of a welcoming medical clinic beside a lake, surrounded by trees" width="640" height="510" fetchpriority="high" />
                    <div class="care-card">
                        <span class="care-icon"><i class="bi bi-heart-pulse" aria-hidden="true"></i></span>
                        <div><strong>Your health. Our priority.</strong><span>Care that puts you first.</span></div>
                        <i class="bi bi-arrow-up-right ms-auto" aria-hidden="true"></i>
                    </div>
                    <span class="visual-caption">LAKESIDE MEDICAL CLINIC <span>JLT, DUBAI</span></span>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="care-strip">
    <div class="container">
        <div class="row gy-3">
            <div class="col-md-4"><i class="bi bi-person-heart" aria-hidden="true"></i> Personal care, for every generation</div>
            <div class="col-md-4"><i class="bi bi-grid" aria-hidden="true"></i> Four specialties, one familiar place</div>
            <div class="col-md-4"><i class="bi bi-geo-alt" aria-hidden="true"></i> In the heart of your neighbourhood</div>
        </div>
    </div>
</div>

<section class="section-space section-anchor" id="specialties" aria-labelledby="specialties-title">
    <div class="container">
        <div class="section-heading">
            <div><span class="eyebrow">CARE FOR EVERY PART OF YOU</span><h2 id="specialties-title">Our Specialties</h2></div>
            <p>From everyday check-ups to specialist advice,<br class="d-none d-md-block" /> find the care you need, under one roof.</p>
        </div>
        <div class="row g-4">
            <div class="col-sm-6 col-lg-3">
                <article class="specialty-card">
                    <span class="specialty-icon"><i class="bi bi-heart-pulse" aria-hidden="true"></i></span>
                    <span class="card-number" aria-hidden="true">01</span>
                    <h3>General Physician</h3>
                    <p>Everyday healthcare, preventive check-ups and care for the whole family.</p>
                    <a asp-page="/Booking/Index" asp-route-specialty="General Physician">Book a visit <i class="bi bi-arrow-right" aria-hidden="true"></i><span class="visually-hidden"> with a General Physician</span></a>
                </article>
            </div>
            <div class="col-sm-6 col-lg-3">
                <article class="specialty-card">
                    <span class="specialty-icon"><i class="bi bi-ear" aria-hidden="true"></i></span>
                    <span class="card-number" aria-hidden="true">02</span>
                    <h3>ENT</h3>
                    <p>Focused care for your ears, nose and throat, helping you feel your best.</p>
                    <a asp-page="/Booking/Index" asp-route-specialty="ENT">Book a visit <i class="bi bi-arrow-right" aria-hidden="true"></i><span class="visually-hidden"> with an ENT specialist</span></a>
                </article>
            </div>
            <div class="col-sm-6 col-lg-3">
                <article class="specialty-card">
                    <span class="specialty-icon"><i class="bi bi-emoji-smile" aria-hidden="true"></i></span>
                    <span class="card-number" aria-hidden="true">03</span>
                    <h3>Dentist</h3>
                    <p>Gentle dental care to keep your teeth healthy and your smile confident.</p>
                    <a asp-page="/Booking/Index" asp-route-specialty="Dentist">Book a visit <i class="bi bi-arrow-right" aria-hidden="true"></i><span class="visually-hidden"> with a Dentist</span></a>
                </article>
            </div>
            <div class="col-sm-6 col-lg-3">
                <article class="specialty-card">
                    <span class="specialty-icon"><i class="bi bi-activity" aria-hidden="true"></i></span>
                    <span class="card-number" aria-hidden="true">04</span>
                    <h3>Cardiologist</h3>
                    <p>Dedicated heart health support, from prevention to ongoing care.</p>
                    <a asp-page="/Booking/Index" asp-route-specialty="Cardiologist">Book a visit <i class="bi bi-arrow-right" aria-hidden="true"></i><span class="visually-hidden"> with a Cardiologist</span></a>
                </article>
            </div>
        </div>
    </div>
</section>

<section class="about-section section-anchor" id="about" aria-labelledby="about-title">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-5">
                <span class="eyebrow">ABOUT US</span>
                <h2 id="about-title">A familiar place.<br />A healthier you.</h2>
                <p class="about-intro">Good healthcare starts with feeling heard.</p>
            </div>
            <div class="col-lg-7 about-content">
                <p>At Lakeside Medical Clinic, we believe looking after your health should feel simple, reassuring and personal. Located in Jumeirah Lakes Towers, we bring everyday healthcare and specialist services closer to home.</p>
                <p>Whether you're coming in for a routine check-up or looking for guidance on a health concern, our approach is the same: time to listen, clear explanations and care centred around you.</p>
                <div class="about-values"><span><i class="bi bi-check-circle" aria-hidden="true"></i> Patient-first approach</span><span><i class="bi bi-check-circle" aria-hidden="true"></i> Convenient local care</span></div>
            </div>
        </div>
    </div>
</section>

<section class="section-space section-anchor" id="contact" aria-labelledby="contact-title">
    <div class="container">
        <div class="contact-panel">
            <div class="row g-5">
                <div class="col-lg-5">
                    <span class="eyebrow">LET'S TAKE CARE OF YOU</span>
                    <h2 id="contact-title">Your next step<br />to feeling better.</h2>
                    <p>Book your visit online or find us in JLT. We're here to help you find the right care.</p>
                    <a class="btn btn-primary" asp-page="/Booking/Index">Book an appointment <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
                    <span class="contact-note"><i class="bi bi-info-circle" aria-hidden="true"></i> Review your details before confirming your appointment online.</span>
                </div>
                <div class="col-lg-6 offset-lg-1">
                    <div class="contact-detail">
                        <i class="bi bi-geo-alt" aria-hidden="true"></i>
                        <div><h3>Find us</h3><address>Cluster X, JLT, Dubai, UAE</address><a href="https://www.google.com/maps/search/?api=1&amp;query=Cluster+X+JLT+Dubai" target="_blank" rel="noopener noreferrer">Explore the area <i class="bi bi-arrow-up-right" aria-hidden="true"></i><span class="visually-hidden"> (opens in a new tab)</span></a></div>
                    </div>
                    <div class="contact-detail">
                        <i class="bi bi-telephone" aria-hidden="true"></i>
                        <div><h3>Call the clinic</h3><p>Phone number to be added</p></div>
                    </div>
                    <div class="contact-detail">
                        <i class="bi bi-clock" aria-hidden="true"></i>
                        <div><h3>Opening hours</h3><p>Monday - Saturday <strong>9am - 9pm</strong></p><p class="closed-day">Sunday <span>Closed</span></p></div>
                    </div>
                </div>
            </div>
            <p class="sample-notice">Sample clinic details shown. Confirm the address, phone number and clinic information before publishing. For a medical emergency in the UAE, call <a href="tel:998">998</a>.</p>
        </div>
    </div>
</section>
