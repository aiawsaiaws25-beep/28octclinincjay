@page "/reception"
@model ReceptionModel
@{
    ViewData["Title"] = "Reception dashboard";
}

<section class="reception-dashboard">
    <div class="container">
        <header class="reception-heading">
            <div>
                <span class="eyebrow">LAKESIDE MEDICAL RECEPTION &middot; LONDON INTERNATIONAL &middot; LISRC.AE</span>
                <h1 class="page-title">Reception</h1>
                <p class="reception-date">@Model.ClinicDate.ToString("dddd, d MMMM yyyy") <span>Dubai time</span></p>
            </div>
            <span class="reception-byline">by Aisha Khan</span>
        </header>

        <div class="reception-count" aria-live="polite">
            <strong>@Model.AppointmentCount</strong>
            <span>appointment@(Model.AppointmentCount == 1 ? "" : "s") today</span>
        </div>

        @if (TempData["ReceptionMessage"] is string message)
        {
            <p class="alert alert-info" role="status">@message</p>
        }

        @if (Model.AppointmentsByDoctor.Count == 0)
        {
            <div class="reception-empty">There are no appointments scheduled for today.</div>
        }
        else
        {
            @foreach (var doctorGroup in Model.AppointmentsByDoctor)
            {
                <section class="reception-doctor" aria-labelledby="doctor-@doctorGroup.First().Id">
                    <h2 id="doctor-@doctorGroup.First().Id">@doctorGroup.Key</h2>
                    <div class="table-responsive">
                        <table class="table reception-table">
                            <thead>
                                <tr>
                                    <th scope="col">Patient</th>
                                    <th scope="col">Time</th>
                                    <th scope="col">Specialty</th>
                                    <th scope="col">Status</th>
                                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var appointment in doctorGroup)
                                {
                                    <tr>
                                        <td>@appointment.PatientName</td>
                                        <td>@appointment.AppointmentDateTime.ToString("h:mm tt")</td>
                                        <td>@appointment.Specialty</td>
                                        <td><span class="reception-status">@appointment.Status</span></td>
                                        <td class="reception-actions">
                                            @if (appointment.Status == "Booked")
                                            {
                                                <form method="post" asp-page-handler="UpdateStatus">
                                                    <input type="hidden" name="id" value="@appointment.Id" />
                                                    <input type="hidden" name="status" value="Arrived" />
                                                    <button class="btn btn-sm btn-outline-primary" type="submit">Arrived</button>
                                                </form>
                                                <form method="post" asp-page-handler="UpdateStatus">
                                                    <input type="hidden" name="id" value="@appointment.Id" />
                                                    <input type="hidden" name="status" value="No-show" />
                                                    <button class="btn btn-sm btn-outline-secondary" type="submit">No-show</button>
                                                </form>
                                            }
                                            else if (appointment.Status == "Arrived")
                                            {
                                                <form method="post" asp-page-handler="UpdateStatus">
                                                    <input type="hidden" name="id" value="@appointment.Id" />
                                                    <input type="hidden" name="status" value="Done" />
                                                    <button class="btn btn-sm btn-outline-primary" type="submit">Done</button>
                                                </form>
                                                <form method="post" asp-page-handler="UpdateStatus">
                                                    <input type="hidden" name="id" value="@appointment.Id" />
                                                    <input type="hidden" name="status" value="No-show" />
                                                    <button class="btn btn-sm btn-outline-secondary" type="submit">No-show</button>
                                                </form>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(appointment.PatientEmail))
                                            {
                                                var reminderSubject = Uri.EscapeDataString("Appointment reminder - Lakeside Medical Clinic");
                                                var reminderBody = Uri.EscapeDataString($"Hello {appointment.PatientName}, this is a reminder of your {appointment.Specialty} appointment with {appointment.Doctor} today at {appointment.AppointmentDateTime:h:mm tt} at Cluster X, JLT, Dubai. — Lakeside Medical Clinic");
                                                <a class="btn btn-sm btn-outline-secondary"
                                                   href="mailto:@appointment.PatientEmail?subject=@reminderSubject&amp;body=@reminderBody">Send reminder</a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            }
        }
        <p class="reception-footnote">Send reminder opens a prefilled message in your email app; it does not send automatically.</p>
    </div>
</section>
