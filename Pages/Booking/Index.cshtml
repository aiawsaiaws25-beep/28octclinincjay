@page
@model LakesideMedical.Pages.Booking.IndexModel
@using LakesideMedical.Models
@using System.Globalization
@{
    ViewData["Title"] = "Book an appointment";
    var labels = new[] { "Specialty", "Doctor", "Date & time", "Patient details", "Review" };
}
<section class="section-space">
    <div class="container booking-container">
        <span class="eyebrow">LET'S TAKE CARE OF YOU</span>
        <h1 class="page-title">Book an appointment</h1>
        <p>Choose your care, find a time and confirm your visit.</p>
        <p class="form-text">AED 100 refundable deposit via Stripe test checkout. If you leave checkout without paying, your appointment remains Pending, not confirmed. Contact the clinic before booking again.</p>
        <ol class="booking-steps" aria-label="Booking progress">
            @for (var index = 0; index < labels.Length; index++)
            {
                <li class="@(index + 1 == Model.Step ? "current" : index + 1 < Model.Step ? "complete" : "")"
                    aria-current="@(index + 1 == Model.Step ? "step" : null)">
                    <span>@(index + 1)</span>@labels[index]
                </li>
            }
        </ol>
        <div class="booking-panel">
            <form method="post">
                <input type="hidden" asp-for="Step" />
                <div asp-validation-summary="All" class="text-danger" role="alert"></div>

                @if (Model.Step != 1)
                {
                    <input type="hidden" asp-for="Input.Specialty" />
                }
                @if (Model.Step != 2)
                {
                    <input type="hidden" asp-for="Input.Doctor" />
                }
                @if (Model.Step != 3)
                {
                    <input type="hidden" asp-for="Input.Date" asp-format="{0:yyyy-MM-dd}" />
                    <input type="hidden" asp-for="Input.Time" />
                }
                @if (Model.Step != 4)
                {
                    <input type="hidden" asp-for="Input.PatientName" />
                    <input type="hidden" asp-for="Input.PatientPhone" />
                    <input type="hidden" asp-for="Input.PatientEmail" />
                }

                @if (Model.Step == 1)
                {
                    <fieldset>
                        <legend>1. Choose a specialty</legend>
                        <div class="row g-3">
                            @foreach (var specialty in BookingSchedule.Doctors.Keys)
                            {
                                <div class="col-sm-6">
                                    <label class="choice-card">
                                        <input type="radio" asp-for="Input.Specialty" value="@specialty" required />
                                        <span>@specialty</span>
                                    </label>
                                </div>
                            }
                        </div>
                    </fieldset>
                }
                else if (Model.Step == 2)
                {
                    <fieldset>
                        <legend>2. Choose a doctor</legend>
                        <p>@Model.Input.Specialty</p>
                        @if (BookingSchedule.Doctors.TryGetValue(Model.Input.Specialty, out var doctor))
                        {
                            <label class="choice-card">
                                <input type="radio" asp-for="Input.Doctor" value="@doctor" required />
                                <span>@doctor <small>@Model.Input.Specialty</small></span>
                            </label>
                        }
                    </fieldset>
                }
                else if (Model.Step == 3)
                {
                    <h2 class="form-heading">3. Choose a date and time</h2>
                    <p>@Model.Input.Doctor &middot; @Model.Input.Specialty</p>
                    <div class="mb-4">
                        <label asp-for="Input.Date" class="form-label"></label>
                        <div class="d-flex flex-wrap gap-2">
                            <input asp-for="Input.Date" type="date" class="form-control date-input" min="@Model.Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" />
                            <button type="submit" class="btn btn-outline-primary" asp-page-handler="Slots" formnovalidate>Show available times</button>
                        </div>
                        <span asp-validation-for="Input.Date" class="text-danger"></span>
                    </div>
                    <fieldset>
                        <legend class="form-label">Time slot (Dubai time, UTC+4)</legend>
                        <p class="form-text">Choose a date and select "Show available times" first. Mon-Sat, 9am-9pm. Last appointment: 8:30pm.</p>
                        <div class="slot-grid">
                            @foreach (var time in BookingSchedule.TimeSlots)
                            {
                                <label class="slot-choice @(Model.IsSlotUnavailable(time) ? "unavailable" : "")">
                                    <input type="radio" asp-for="Input.Time" value="@time" disabled="@Model.IsSlotUnavailable(time)" required />
                                    <span>@BookingSchedule.DisplayTime(time)</span>
                                </label>
                            }
                        </div>
                        <span asp-validation-for="Input.Time" class="text-danger"></span>
                    </fieldset>
                }
                else if (Model.Step == 4)
                {
                    <h2 class="form-heading">4. Your details</h2>
                    @if (!Model.IsSignedIn)
                    {
                        <p>Already a patient? <a asp-page="/Account/Login" asp-route-returnUrl="/Booking">Log in before booking</a>, or continue as a guest. Use your own email to find this booking in your account later.</p>
                    }
                    <div class="mb-3">
                        <label asp-for="Input.PatientName" class="form-label"></label>
                        <input asp-for="Input.PatientName" class="form-control" autocomplete="name" />
                        <span asp-validation-for="Input.PatientName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.PatientPhone" class="form-label"></label>
                        <input asp-for="Input.PatientPhone" type="tel" class="form-control" autocomplete="tel" />
                        <span asp-validation-for="Input.PatientPhone" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.PatientEmail" class="form-label"></label>
                        <input asp-for="Input.PatientEmail" type="email" class="form-control" autocomplete="email" readonly="@Model.IsSignedIn" />
                        <span asp-validation-for="Input.PatientEmail" class="text-danger"></span>
                        @if (Model.IsSignedIn)
                        {
                            <div class="form-text">Your account email is used so this booking appears in My Appointments.</div>
                        }
                    </div>
                }
                else
                {
                    <h2 class="form-heading">Review your appointment</h2>
                    <p>Check your details below. Confirming saves a Pending appointment and opens Stripe's secure test checkout for a one-off <strong>AED 100 refundable consultation deposit</strong>. Your booking is confirmed only after Stripe verifies payment.</p>
                    <p class="form-text">Test mode only: no real money is charged. Contact the clinic to request a refund; cancelling a booking does not automatically refund a deposit. If you leave checkout, your appointment stays Pending.</p>
                    <dl class="appointment-details">
                        <dt>Specialty</dt><dd>@Model.Input.Specialty</dd>
                        <dt>Doctor</dt><dd>@Model.Input.Doctor</dd>
                        <dt>Date &amp; time</dt><dd>@Model.Input.Date?.ToString("ddd, d MMM yyyy", CultureInfo.InvariantCulture) at @(BookingSchedule.TimeSlots.Contains(Model.Input.Time) ? BookingSchedule.DisplayTime(Model.Input.Time) : Model.Input.Time) (Dubai)</dd>
                        <dt>Patient</dt><dd>@Model.Input.PatientName</dd>
                        <dt>Phone</dt><dd>@Model.Input.PatientPhone</dd>
                        <dt>Email</dt><dd>@Model.Input.PatientEmail</dd>
                    </dl>
                }
                <div class="booking-actions">
                    @if (Model.Step > 1)
                    {
                        <button class="btn btn-outline-primary" type="submit" asp-page-handler="Back" formnovalidate>Back</button>
                    }
                    @if (Model.Step < 5)
                    {
                        <button class="btn btn-primary ms-auto" type="submit" asp-page-handler="Next">Continue <i class="bi bi-arrow-right" aria-hidden="true"></i></button>
                    }
                    else
                    {
                        <button class="btn btn-primary ms-auto" type="submit" asp-page-handler="Confirm">Confirm booking &amp; pay AED 100 <i class="bi bi-arrow-up-right" aria-hidden="true"></i></button>
                    }
                </div>
            </form>
        </div>
    </div>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
