@page
@model LakesideMedical.Pages.Booking.ConfirmationModel
@using System.Globalization
@{
    ViewData["Title"] = "Booking confirmed";
}
<section class="section-space">
    <div class="container booking-container">
        <div class="booking-panel">
            <span class="confirmation-icon"><i class="bi bi-check-circle" aria-hidden="true"></i></span>
            <span class="eyebrow">SEE YOU SOON</span>
            <h1 class="page-title">Booking confirmed</h1>
            <p>Your appointment has been saved. Reference: <strong>LM-@Model.Appointment.Id</strong></p>
            <dl class="appointment-details">
                <dt>Specialty</dt><dd>@Model.Appointment.Specialty</dd>
                <dt>Doctor</dt><dd>@Model.Appointment.Doctor</dd>
                <dt>Date &amp; time</dt><dd>@Model.Appointment.AppointmentDateTime.ToString("ddd, d MMM yyyy 'at' h:mm tt", CultureInfo.InvariantCulture) (Dubai)</dd>
                <dt>Patient</dt><dd>@Model.Appointment.PatientName</dd>
                <dt>Phone</dt><dd>@Model.Appointment.PatientPhone</dd>
                <dt>Email</dt><dd>@Model.Appointment.PatientEmail</dd>
                <dt>Status</dt><dd>@Model.Appointment.Status</dd>
                <dt>Location</dt><dd>Cluster X, JLT, Dubai, UAE</dd>
            </dl>
            <p class="form-text">No confirmation email is sent yet. Keep your reference or log in using the booking email to manage your appointment. This private confirmation link expires after 30 minutes.</p>
            <div class="d-flex flex-wrap gap-3 mt-4">
                <a class="btn btn-primary" asp-page="/MyAppointments">My Appointments</a>
                <a class="btn btn-outline-primary" asp-page="/Index">Back to home</a>
            </div>
        </div>
    </div>
</section>
